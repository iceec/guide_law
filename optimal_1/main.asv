xm = 0; ym = 0;
xt = 8000; yt = 0;
vm = 1000; vt = 500;

delt_t = 0 /180*pi;
delt_m = 20 / 180 *pi;

r = sqrt((xm-xt)^2 + (ym - yt)^2);
q = atan2(yt-ym,xt-xm);

h = 0.001;
N = 1000 * 20;

XM =zeros(1,N);
YM =zeros(1,N);
XT =zeros(1,N);
YT =zeros(1,N);
R = zeros(1,N);
AM = zeros(1,N);

n = 1;
am_pre = 0;
z1 = 0;
z2 = 0;
Z2 = zeros(1,N);
A2 = zeros(1,N);

time = 0 : 0.001 :20;

while r > 0 && n < N

    R(n) = r;
    XM(n) = xm; YM(n) = ym; XT(n) = xt; YT(n) = yt;
    [dr,dq,ddelt_m,ddelt_t,am,dz1,dz2] = dynamic(vm,vt,r,q,delt_m,delt_t,z1,z2,am_pre,n*h);


    z1 = z1 + h * dz1;
    z2 = z2 + h * dz2;

    Z2(n) = z2 / cos(delt_t - q);
    A2(n) = -7 * 9.81 * sin(n*);


    AM(n) = am / 9.81;

    am_pre = am;
    

    r = r + h *dr;
    q = q + h *dq;
    delt_m = delt_m + h *ddelt_m;
    delt_t = delt_t + h * ddelt_t;

    xm = xm + vm * cos(delt_m) * h;
    ym = ym + vm * sin(delt_m) * h;

    xt = xt + vt * cos(delt_t) * h;
    yt = yt + vt * sin(delt_t) * h;

    n = n + 1; 

    if mod(n,1000) == 0
        disp(r)
    end
end


%plot(R(1:n-1),'LineWidth',2);

figure(1);
plot(XM(1:n-1),YM(1:n-1),'LineWidth',2);

figure(2);
plot(time(1:n-1),Z2(1:n-1),time(1:n-1),A2(1:n-1),'LineWidth',2);




