# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = D:/MatLab/R2022a
startdir = D:/MatLab/MissleGuide/stationary/slide_1

# Toolchain information
cc = C:\msys64\mingw64\bin\gcc
cxx = C:\msys64\mingw64\bin\g++
linker = C:\msys64\mingw64\bin\gcc
linkerxx = C:\msys64\mingw64\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "D:\MatLab\MissleGuide\stationary\slide_1\codegen\mex\dynamic" -I "D:\MatLab\MissleGuide\stationary\slide_1" -I "D:\MatLab\MissleGuide\stationary\slide_1\codegen\mex\dynamic\interface" -I "D:\MatLab\R2022a\extern\include" -I "." -DMODEL=dynamic_mex -D__USE_MINGW_ANSI_STDIO=1 -DMW_NEEDS_VERSION_H  

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -std=c++11 -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "D:\MatLab\MissleGuide\stationary\slide_1\codegen\mex\dynamic" -I "D:\MatLab\MissleGuide\stationary\slide_1" -I "D:\MatLab\MissleGuide\stationary\slide_1\codegen\mex\dynamic\interface" -I "D:\MatLab\R2022a\extern\include" -I "." -DMODEL=dynamic_mex -D__USE_MINGW_ANSI_STDIO=1 -DMW_NEEDS_VERSION_H  

ldflags =  -m64 -Wl,--no-undefined -shared -static -L"D:\MatLab\R2022a\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "dynamic_mex.mexw64" -llibemlrt -llibcovrt -llibut -llibmwmathutil 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $ldflags

# Build
build $builddir/dynamic_data.o : cxx $root/dynamic_data.cpp
build $builddir/rt_nonfinite.o : cxx $root/rt_nonfinite.cpp
build $builddir/dynamic_initialize.o : cxx $root/dynamic_initialize.cpp
build $builddir/dynamic_terminate.o : cxx $root/dynamic_terminate.cpp
build $builddir/dynamic.o : cxx $root/dynamic.cpp
build $builddir/W.o : cxx $root/W.cpp
build $builddir/rand.o : cxx $root/rand.cpp
build $builddir/_coder_dynamic_api.o : cxx $root/interface/_coder_dynamic_api.cpp
build $builddir/_coder_dynamic_mex.o : cxx $root/interface/_coder_dynamic_mex.cpp
build $builddir/nthroot.o : cxx $root/nthroot.cpp
build $builddir/_coder_dynamic_info.o : cxx $root/interface/_coder_dynamic_info.cpp
build $builddir/cpp_mexapi_version.o : cxx $matlabdir/extern/version/cpp_mexapi_version.cpp

# Link
build $root\dynamic_mex.mexw64 : linkxx $builddir/dynamic_data.o $builddir/rt_nonfinite.o $builddir/dynamic_initialize.o $builddir/dynamic_terminate.o $builddir/dynamic.o $builddir/W.o $builddir/rand.o $builddir/_coder_dynamic_api.o $builddir/_coder_dynamic_mex.o $builddir/nthroot.o $builddir/_coder_dynamic_info.o $builddir/cpp_mexapi_version.o 
